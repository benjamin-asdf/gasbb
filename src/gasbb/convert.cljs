(ns gasbb.convert
  "Conversions between Clojure data and the plain JS values Apps Script
  services hand out and accept."
  (:require [clojure.string :as str]))

(defn- js-array? [x] (.isArray js/Array x))

(defn- plain-object? [x]
  (and (some? x)
       (identical? (type x) js/Object)))

(defn ->clj
  "JS -> Clojure. Arrays become vectors, plain objects become keyword maps.
  Dates and Apps Script service objects (Range, Sheet, ...) are kept as is."
  [x]
  (cond
    (js-array? x) (mapv ->clj x)
    (plain-object? x) (into {} (map (fn [k] [(keyword k) (->clj (unchecked-get x k))]))
                            (js-keys x))
    :else x))

(defn ->js
  "Clojure -> JS. Keywords become strings (namespace kept), maps become
  objects, sequential collections and sets become arrays."
  [x]
  (cond
    (keyword? x) (if-let [n (namespace x)] (str n "/" (name x)) (name x))
    (symbol? x) (str x)
    (map? x) (let [o #js {}]
               (doseq [[k v] x] (unchecked-set o (->js k) (->js v)))
               o)
    (or (sequential? x) (set? x)) (into-array (map ->js x))
    :else x))

(deftype ^:private LimitedWriter [parts ^:mutable n limit]
  IWriter
  (-write [_ s]
    (.push parts s)
    (set! n (+ n (count s)))
    (when (> n limit)
      (throw (ex-info "limit reached" {::limit true}))))
  (-flush [_] nil))

(defn pr-str-limited
  "pr-str with *print-length* 100 that stops after `limit` characters, so
  printing an infinite or huge structure ends."
  [x limit]
  (let [parts #js []
        opts {:readably true :print-length 100}]
    (try
      (pr-writer x (->LimitedWriter parts 0 limit) opts)
      (.join parts "")
      (catch :default e
        (if (::limit (ex-data e))
          (str (subs (.join parts "") 0 (- limit 3)) "...")
          (throw e))))))

(defn- cap
  "A cell holds at most 50000 characters."
  [s]
  (if (> (count s) 50000) (str (subs s 0 49997) "...") s))

(defn- cell-scalar [x]
  (cond
    (nil? x) ""
    (string? x) (cap x)
    (or (number? x) (boolean? x) (inst? x)) x
    (keyword? x) (cap (->js x))
    (symbol? x) (cap (str x))
    :else (pr-str-limited x 50000)))

(defn- row [x]
  (if (or (sequential? x) (set? x))
    (mapv cell-scalar x)
    [(cell-scalar x)]))

(defn- pad [rows]
  (let [w (reduce max 1 (map count rows))]
    (mapv #(into % (repeat (- w (count %)) "")) rows)))

(def max-cell-items
  "More than this many items in a result is almost surely a mistake, e.g. an
  infinite `(range)`; =CLJ fails with a message instead of hanging."
  50000)

(defn- check-size!
  "Throws when `xs` has more than `max-cell-items` items, without realizing
  more of it than that."
  [xs]
  (when (> (bounded-count (inc max-cell-items) xs) max-cell-items)
    (throw (ex-info (str "result has more than " max-cell-items
                         " items (infinite sequence?), use take")
                    {})))
  xs)

(defn ->cell
  "Clojure -> a value a custom spreadsheet function may return: a scalar or a
  rectangular 2D array. A flat sequence spills down one column, a sequence
  of sequences fills a range, a map spills as key/value rows and a sequence
  of maps as a table with a header row."
  [x]
  (cond
    (map? x) (->cell (map (fn [[k v]] [k v]) x))
    (or (sequential? x) (set? x))
    (let [xs (seq x)]
      (check-size! xs)
      (run! #(when (or (sequential? %) (set? %)) (check-size! %)) xs)
      (cond
        (nil? xs) ""
        ;; a table: header row of keys, then one aligned row per map
        (every? map? xs)
        (let [ks (distinct (mapcat keys xs))]
          (if (empty? ks)
            ""
            (->js (into [(mapv cell-scalar ks)]
                      (map (fn [m] (mapv #(cell-scalar (get m %)) ks)))
                      xs))))
        (some #(or (sequential? %) (set? %) (map? %)) xs)
        (->js (pad (map (fn [r] (if (map? r) (row (vals r)) (row r))) xs)))
        :else (->js (mapv (comp vector cell-scalar) xs))))
    :else (cell-scalar x)))

(defn header->key [h]
  (-> (str h) str/trim str/lower-case (str/replace #"[^a-z0-9]+" "-")
      (str/replace #"^-|-$" "") keyword))
