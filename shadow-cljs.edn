{:deps false
 :source-paths ["src"]
 :dependencies [[org.babashka/sci "0.15.59"]]
 :jvm-opts ["-Xmx4g"]
 :builds
 {:gasbb {:target :browser
        :output-dir "dist"
        :asset-path "."
        :modules {:gasbb {:init-fn gasbb.core/init
                          :prepend "// gasbb: Clojure for Google Apps Script, https://github.com/benjamin-asdf/gasbb\n// Generated by Claude Code on behalf of Benjamin Schwerdtner.\n"}}
        :compiler-options {:output-feature-set :es2020
                           :optimizations :advanced}
        :release {:compiler-options {:infer-externs :auto}}}}}
